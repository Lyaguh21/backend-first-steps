generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?  @unique
  age       Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  passwordHash       String
  hashedRefreshToken String? // может быть null (если не залогинен)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
